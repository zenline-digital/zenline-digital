{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/claude.js": {
      "maxDuration": 30
    },
    "api/seo-cron.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/seo-cron",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
